{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RoleDto",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "format": "int64"
        }
    },
    "patternProperties": {
        "^type$": {
            "type": "string",
            "enum": [
              "ORGANIZER",
              "SYSADMIN",
              "ADMIN",
              "LECTURER",
              "STUDENT",
              "USER"
            ]
        }
    },
    "required": ["id", "type"],
    "additionalProperties": false
}