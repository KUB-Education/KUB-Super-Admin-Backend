{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "RefreshResponse",
    "type": "object",
    "properties": {
          "access_token": {
              "type": "string",
              "description": "New JWT access token."
          },
          "refresh_token": {
              "type": "string",
              "description": "New JWT refresh token."
          }
    },
    "required": ["access_token", "refresh_token"]
}