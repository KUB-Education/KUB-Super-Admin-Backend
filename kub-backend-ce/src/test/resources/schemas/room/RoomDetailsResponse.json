{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomDetailsResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    }
  },
  "patternProperties": {
    "^description$": {
      "type": ["string", "null"]
    }
  },
  "required":  ["id", "location", "capacity"],
  "additionalProperties": false
}